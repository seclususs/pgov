package {
    default_applicable_licenses: ["pgov_license"],
}

license {
    name: "pgov_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-GPL-3.0",
    ],
    license_text: [
        "LICENSE",
    ],
}

cc_library_static {
    name: "libpgov",
    srcs: [
        "src/**/*.c",
    ],
    exclude_srcs: [
        "src/main.c",
        "src/core/sweep.c",
        "src/sys/conf.c",
        "src/sys/fs.c",
        "src/sys/opt.c",
        "src/sys/block.c",
    ],
    local_include_dirs: ["include"],
    export_include_dirs: ["include"],
    c_std: "c11",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-O2",
        "-ffunction-sections",
        "-fdata-sections",
        "-fvisibility=hidden",
        "-fno-math-errno",
        "-fno-signed-zeros",
        "-fno-trapping-math",
    ],
    lto: {
        thin: true,
    },
    vendor: true,
}

cc_binary {
    name: "pgovd",
    srcs: ["src/main.c"],
    c_std: "c11",
    static_libs: [
        "libpgov",
    ],
    shared_libs: [
        "liblog",
    ],
    init_rc: ["pgovd.rc"],
    ldflags: [
        "-Wl,--gc-sections",
        "-Wl,--icf=all",
    ],
    lto: {
        thin: true,
    },
    vendor: true,
}